# Optional: keep large/raw datasets out of Git
data/
*.parquet

# Training artifacts under outputs/ are not committed; the specific files the
# deployed registry needs are un-ignored further down.
#
# Scoped to outputs/ rather than a blanket *.pt / *.joblib on purpose: the
# Hugging Face uploader applies .gitignore but does NOT honour negation lines,
# so a blanket rule silently dropped every model binary from the Space while
# reporting a successful commit. Keeping the pattern narrow means the
# deployment artifacts never match it and need no negation.
outputs/**/*.pt
outputs/**/*.pth
outputs/**/*.joblib

# Docker/local
docker-compose.override.yml

# Small trained artifacts required by the deployed horizon registry.
!outputs/BTC_1h_target1h_sentiment_v3_200ep/final_deep__vae_transformer_v2__market_only/market_scaler.joblib
!outputs/BTC_1h_target1h_sentiment_v3_200ep/final_deep__vae_transformer_v2__market_only/model_state.pt
!outputs/BTC_1h_target24h_sentiment_v3_200ep/final_deep__vae_transformer_v2__market_plus_sentiment/market_scaler.joblib
!outputs/BTC_1h_target24h_sentiment_v3_200ep/final_deep__vae_transformer_v2__market_plus_sentiment/model_state.pt
!outputs/BTC_1h_target24h_sentiment_v3_200ep/final_deep__vae_transformer_v2__market_plus_sentiment/sentiment_scaler.joblib
!outputs/BTC_1h_target6h_sentiment_v3_200ep/final_deep__gru__market_plus_sentiment/model_state.pt
!outputs/BTC_1h_target6h_sentiment_v3_200ep/final_deep__gru__market_plus_sentiment/scaler.joblib
