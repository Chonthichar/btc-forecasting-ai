# Required only for the LLM explanation/chat layer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
TAVILY_API_KEY=
RELIABILITY_THRESHOLD=0.50
NEWS_CACHE_MINUTES=10

# Optional but recommended for live sentiment collection
ALPHA_VANTAGE_API_KEY=

# Normally you can leave these unset for local/Docker use
# BTC_PROJECT_ROOT=/absolute/path/to/btc_forecasting_production
# BTC_SENTIMENT_SCRIPT=/absolute/path/to/btc_forecasting_production/sentiment_pipeline/btc_sentiment_agents.py

PORT=7860

API_PORT=8000

# Market scans are scheduled; paid research is event-triggered.
MONITOR_INTERVAL_MINUTES=60
# Optional: private dataset repository for Space history backups. Keep the token
# in local .env or Hugging Face Settings > Secrets, never in source control.
MONITOR_BACKUP_REPO=
MONITOR_BACKUP_TOKEN=
PRICE_MOVE_TRIGGER_PCT=1.0
VOLATILITY_TRIGGER_MULTIPLIER=1.5
SENTIMENT_SHIFT_THRESHOLD=0.25
RESEARCH_COOLDOWN_MINUTES=30
